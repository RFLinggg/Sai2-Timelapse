# ---------------------------------------------------------------- 打包产物
# 二进制走 Release，不进 git。dist 里 273MB，推上去会把仓库撑死。
dist/
build/
build-onedir/
dist_new/
_staging/
_backup/

# ---------------------------------------------------------------- 环境
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------- 录制 / 测试产物
# 整个 probe/ 都不进仓库：
#   probe/incoming、probe/sniff_exe 里是从别人画布读出来的缩略图和嗅探报告
#   probe/*.log 里有完整的 SAI 安装路径、画布文件名、exe 路径
#   其余 200 多个 check_*.py / *.png 是一次性验证脚本，对本项目是噪音
probe/
*.log

# ---------------------------------------------------------------- 素材
# 1.webm / als.webm 是录制样本，30MB 那个不是自己的画。
*.webm
*.mp4
视频素材/

# ---------------------------------------------------------------- 本地配置 / 系统
# 工作记忆目录是内部记录，含用户反馈细节和本机路径，不公开
.workbuddy-ai/
.art-timelapse
Thumbs.db
desktop.ini
.DS_Store
__MACOSX/
