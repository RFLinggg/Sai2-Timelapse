msgstr "继续"

#: webapp.py
msgid "Paused"
msgstr "已暂停"

#: webapp.py
msgid "Recording paused"
msgstr "录制已暂停"

#: webapp.py
msgid "Recording resumed"
msgstr "已恢复录制"

#: webapp.py
msgid "Stop recording?"
msgstr "结束这次录制？"

#: webapp.py
msgid "{} frames recorded · {}. You can export it from the Export tab afterwards."
msgstr "已录 {} 帧 · {}。结束后可以到「导出视频」页生成成片。"

#: webapp.py
msgid "Cancel"
msgstr "取消"

#: webapp.py — 号码本身在前端 DOM 里，这条只是标签
msgid "Feedback QQ group"
msgstr "反馈 QQ 群"

msgid "Floating bar"
msgstr "悬浮窗"

msgid "Append to last session"
msgstr "接着上次录制"

msgid "Archive frames"
msgstr "归档这批帧"

msgid "Continuing session {1} ({0} frames already recorded)"
msgstr "继续写入会话 {1}（已有 {0} 帧）"

msgid "Last session is {0}; this recording starts a new clip. Turn on \"Append to last session\" to continue that one instead."
msgstr "上次的录制是 {0}，这次会另开一段。想接着上次继续画，把「接着上次录制」打开。"

msgid "Canvas is {}x{} but the existing recording is {}x{}; on export that part will be scaled and letterboxed."
msgstr "画布 {}×{} 与已有录制的 {}×{} 不同，导出时这一段会被缩放并加上黑边。"

msgid "Archived {} frames from session {}"
msgstr "已把 {} 帧从会话 {} 归档"

msgid "Codec {} is not available on this machine; falling back to {} ({})."
msgstr "本机不支持编码器 {}，已自动改用 {}（{}）。"

msgid "GPU acceleration disabled by ART_TIMELAPSE_NO_GPU"
msgstr "已按环境变量禁用 WebView2 的 GPU 加速"

msgid "Tk UI forced by ART_TIMELAPSE_UI=tk"
msgstr "已按环境变量切到 Tk 界面"

msgid "Size {}x{}, {} fps, writing to {}"
msgstr "尺寸 {}x{}，{} fps，落点 {}"

msgid "Tried: {}"
msgstr "已尝试：{}"

msgid "Canvas size is {}x{} — the SAI version parameters do not match, so nothing can be recorded. Run Sai2-Sniffer and send the report back."
msgstr "画布尺寸是 {}x{} —— SAI 版本参数对不上，录不了。请运行 Sai2-Sniffer 生成报告发回来。"
