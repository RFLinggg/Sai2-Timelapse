msgstr "支持的 SAI 版本：{} 个"

#: gui.py
msgid "Restore default settings"
msgstr "恢复默认设置"

#: gui.py
msgid "All settings except the frames folder, theme, language and window position will be reset. Continue?"
msgstr "除帧目录、主题、语言和窗口位置外，其余设置都会恢复默认。继续吗？"

#: gui.py
msgid "Settings restored to defaults ({} items)"
msgstr "设置已恢复默认（{} 项）"

#: gui.py
msgid "Settings restored to defaults."
msgstr "设置已恢复默认。"

#: gui.py
msgid "Language"
msgstr "语言"

#: gui.py
msgid "Recording"
msgstr "录制中"

#: gui.py
